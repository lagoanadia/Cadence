// Cadence — data model
// Conventions:
// - Money is stored as whole cents (Int), never Float.
// - `date` fields use @db.Date: a calendar day with no time and no timezone.
// - Every table the user logs into carries `userId`, so every query can filter by it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Auth & user ───────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null when the user only signs in with Google/GitHub
  createdAt     DateTime  @default(now())

  accounts          Account[]
  settings          UserSettings?
  areas             Area[]
  tasks             Task[]
  recurringTasks    RecurringTask[]
  recurringDone     RecurringTaskCompletion[]
  routines          Routine[]
  routineChecks     RoutineStepCheck[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  chores            Chore[]
  choreLogs         ChoreLog[]
  books             Book[]
  readingLogs       ReadingLog[]
  workouts          Workout[]
  metrics           Metric[]
  metricEntries     MetricEntry[]
}

// Standard Auth.js model: one row per linked OAuth provider (Google, GitHub)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model UserSettings {
  userId             String  @id
  privateMode        Boolean @default(false)
  monthlyBudgetCents Int?
  weekStartsOn       Int     @default(1) // 0 = Sunday, 1 = Monday
  timezone           String  @default("Europe/Madrid")
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Growth areas ───────────────────────────

model Area {
  id         String    @id @default(cuid())
  userId     String
  name       String
  icon       String // key of AREA_ICONS in src/components/icons.tsx
  color      String // hex, e.g. "#6366f1"
  position   Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks          Task[]
  recurringTasks RecurringTask[]
  routines       Routine[]
  expenses       Expense[]
  chores         Chore[]
  books          Book[]
  workouts       Workout[]
  metrics        Metric[]

  @@unique([userId, name])
}

// ─────────────────────────── Agenda ───────────────────────────

enum Frequency {
  DAILY // every day
  WEEKLY // on the days listed in daysOfWeek (covers "weekly" and "specific weekdays")
  MONTHLY // on dayOfMonth (clamped to the last day of short months)
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  notes       String?
  date        DateTime  @db.Date
  time        String? // "HH:mm"
  areaId      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model RecurringTask {
  id          String                    @id @default(cuid())
  userId      String
  title       String
  time        String?
  areaId      String?
  frequency   Frequency
  daysOfWeek  Int[] // 0 = Sunday … 6 = Saturday (only for WEEKLY)
  dayOfMonth  Int? // 1–31 (only for MONTHLY)
  startDate   DateTime                  @db.Date
  endDate     DateTime?                 @db.Date
  archivedAt  DateTime?
  createdAt   DateTime                  @default(now())
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?                     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  completions RecurringTaskCompletion[]
}

model RecurringTaskCompletion {
  id              String        @id @default(cuid())
  recurringTaskId String
  userId          String
  date            DateTime      @db.Date
  recurringTask   RecurringTask @relation(fields: [recurringTaskId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recurringTaskId, date])
  @@index([userId, date])
}

model Routine {
  id         String        @id @default(cuid())
  userId     String
  name       String
  icon       String?
  areaId     String?
  frequency  Frequency     @default(DAILY)
  daysOfWeek Int[]
  dayOfMonth Int?
  position   Int           @default(0)
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  steps      RoutineStep[]
}

model RoutineStep {
  id        String             @id @default(cuid())
  routineId String
  title     String
  position  Int
  routine   Routine            @relation(fields: [routineId], references: [id], onDelete: Cascade)
  checks    RoutineStepCheck[]
}

model RoutineStepCheck {
  id     String      @id @default(cuid())
  stepId String
  userId String
  date   DateTime    @db.Date
  step   RoutineStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stepId, date])
  @@index([userId, date])
}

// ─────────────────────────── Expenses ───────────────────────────

model ExpenseCategory {
  id       String    @id @default(cuid())
  userId   String
  name     String
  icon     String
  color    String
  position Int       @default(0)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
}

model Expense {
  id          String           @id @default(cuid())
  userId      String
  amountCents Int // 12,50 € → 1250
  categoryId  String?
  note        String?
  date        DateTime         @db.Date
  receiptPath String? // private Blob pathname, served through /api/receipts/[id]
  areaId      String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  area        Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// ─────────────────────────── Home / chores ───────────────────────────

model Chore {
  id            String     @id @default(cuid())
  userId        String
  name          String
  icon          String?
  frequencyDays Int? // ideal frequency: "every 7 days"
  areaId        String?
  position      Int        @default(0)
  archivedAt    DateTime?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  area          Area?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  logs          ChoreLog[]
}

model ChoreLog {
  id        String   @id @default(cuid())
  choreId   String
  userId    String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  chore     Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([choreId, date])
  @@index([userId, date])
}

// ─────────────────────────── Reading ───────────────────────────

enum BookStatus {
  WANT_TO_READ
  READING
  FINISHED
}

model Book {
  id          String       @id @default(cuid())
  userId      String
  title       String
  author      String?
  status      BookStatus   @default(WANT_TO_READ)
  currentPage Int          @default(0)
  totalPages  Int?
  startedAt   DateTime?
  finishedAt  DateTime?
  rating      Int? // 1–5 stars, optional
  review      String? // your own thoughts about the book
  areaId      String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  logs        ReadingLog[]
}

model ReadingLog {
  id     String   @id @default(cuid())
  userId String
  bookId String
  date   DateTime @db.Date
  pages  Int
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book   Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ─────────────────────────── Health & Movement ───────────────────────────

model Workout {
  id          String   @id @default(cuid())
  userId      String
  type        String // "walk", "gym", "yoga" or anything the user types
  durationMin Int
  notes       String?
  date        DateTime @db.Date
  areaId      String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Metric {
  id       String        @id @default(cuid())
  userId   String
  name     String
  unit     String?
  position Int           @default(0)
  areaId   String?
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  area     Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  entries  MetricEntry[]

  @@unique([userId, name])
}

model MetricEntry {
  id       String   @id @default(cuid())
  metricId String
  userId   String
  date     DateTime @db.Date
  value    Float
  metric   Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([metricId, date])
}
