# PostgreSQL connection string
DATABASE_URL="postgresql://cadence:cadence@localhost:5432/cadence?schema=public"

# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Needed when running `next start` outside Vercel (localhost, Docker, a VPS…)
AUTH_TRUST_HOST=true

# Optional OAuth providers — the buttons only appear if both values are set
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Receipt photos (Vercel Blob → Storage → create a store → copy the token).
# Without it, photos are saved in ./.uploads during development only.
BLOB_READ_WRITE_TOKEN=""

# Today's AI assistant (Groq). Create a key at https://console.groq.com/keys
# Without it the app works normally and the assistant card explains how to enable it.
GROQ_API_KEY=""
