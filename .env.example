# PostgreSQL connection string
DATABASE_URL="postgresql://cadence:cadence@localhost:5432/cadence?schema=public"

# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Needed when running `next start` outside Vercel (localhost, Docker, a VPS…)
AUTH_TRUST_HOST=true

# Optional OAuth providers — the buttons only appear if both values are set
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
